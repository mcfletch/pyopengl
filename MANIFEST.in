global-exclude *.odt *.odp .cvsignore *.diff
include ./*.rst ./*.md
exclude src/*.h src/*.xml src/*.zip src/*.pdf src/*.zip src/*.txt
include src/*.py
include tests/*.py tests/*.png
include examples/*.py
include metadata.py
# No OpenGL/DLLS: the prebuilt Windows freeglut and GLE builds are
# PyOpenGL-glut-binaries now, asked for as `pip install PyOpenGL[glut]`. This
# line is what put them in every wheel and sdist on every platform.
include license.txt
include ChangeLog.txt
exclude accelerate
exclude directdocs

# The type stubs and the marker that tells a checker to use them.
include OpenGL/py.typed
include OpenGL/raw/_declarations/*.dat
recursive-include OpenGL *.pyi

# The documentation sources ship; what a build leaves in them does not.
# `docs/reference` and `docs/api` are written by the generators on every build
# and `docs/_build` is the rendered site -- a couple of gigabytes of it, which
# would otherwise land in an sdist made from a checkout that had built the docs.
prune docs/_build
prune docs/reference
prune docs/api
